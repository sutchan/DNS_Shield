{
  "name": "dns-shield",
  "version": "2.2.3",
  "private": true,
  "scripts": {
    "dev": "next dev --port 8082",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "global:install": "npm install -g next react react-dom @babel/preset-env @babel/preset-react @babel/preset-typescript @testing-library/jest-dom @testing-library/react @testing-library/user-event @types/jest @types/node @types/react @types/react-dom autoprefixer babel-jest eslint eslint-config-next identity-obj-proxy jest jest-environment-jsdom postcss tailwindcss ts-jest typescript",
    "global:dev": "npx npm-run-path --env NODE_PATH && next dev --port 8082",
    "global:build": "npx npm-run-path --env NODE_PATH && next build",
    "global:start": "npx npm-run-path --env NODE_PATH && next start",
    "global:lint": "npx npm-run-path --env NODE_PATH && next lint",
    "global:test": "npx npm-run-path --env NODE_PATH && jest"
  },
  "dependencies": {
    "next": "^14",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^30.3.0",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "npm-run-path": "^6.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-jest": "^29.4.9",
    "typescript": "^5"
  }
}
