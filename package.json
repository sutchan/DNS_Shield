{
  "name": "dns-shield",
  "version": "3.22.4",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "test": "vitest run",
    "benchmark:large": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:locales": "node scripts/check-locales.mjs",
    "check:doc-facts": "node scripts/check-doc-facts.mjs",
    "check:api-contract": "node scripts/smoke-openapi.mjs",
    "locales:baseline": "node scripts/check-locales.mjs --update-baseline",
    "count:domains": "node scripts/count-domains.mjs",
    "icons:gen": "node scripts/gen-icons.mjs",
    "build:formats": "node scripts/gen-format-files.mjs",
    "check:root-clean": "node scripts/check-root-clean.mjs",
    "check:a11y": "playwright test --config=playwright.config.ts",
    "tmp:init": "node scripts/manage-tmp.mjs --init",
    "tmp:clean": "node scripts/manage-tmp.mjs --clean"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.312.0",
    "next": "^14.2.25",
    "react": "^18",
    "react-dom": "^18",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.14.1",
    "eslint": "^8",
    "eslint-config-next": "^16",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  }
}
