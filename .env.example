# 环境变量示例模板：复制为 .env.local 后按需修改（.env.local 已被 .gitignore 忽略，不会提交）
# 用法：cp .env.example .env.local

# ── Google Analytics 4 ────────────────────────────────────────────────
# 衡量 ID（形如 G-XXXXXXXXXX）。留空或格式非法时前端不注入任何统计脚本。
# 严禁把真实 ID 写回本文件或源码；正式环境请在部署平台（Vercel / EdgeOne Pages）配置。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── 站点验证 ──────────────────────────────────────────────────────────
# Google Search Console 站点验证 meta 值
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ── 运行时数据源（留空则使用 src/config/index.ts 中的内置默认地址）──────
NEXT_PUBLIC_DOMAINS_URL=
NEXT_PUBLIC_PRESET_BUILTIN=
NEXT_PUBLIC_PRESET_ADGUARD=
NEXT_PUBLIC_PRESET_EASYLIST=
NEXT_PUBLIC_PRESET_NEOHOSTS=
