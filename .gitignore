# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.local
.env.*
!.env.example
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
reports/
*.lcov
.pytest_cache/
test-output/
playwright-report/
test-results/

# Production
build

# Misc
.cache
# 临时文件统一存放于根目录 .tmp/ 子目录（一次性脚本、探针、运行日志、中间产物、
# 缓存、下载文件、测试输出）。唯一合法位置，由 scripts/manage-tmp.mjs 自动创建，
# CI 门禁 scripts/check-root-clean.mjs 拦截根目录散落。详见 docs/TEMP-FILES.md。
# 注意：被忽略 ≠ 被允许——门禁对根目录临时产物即使已 ignore 仍判违规。
.tmp/

# Package manager
# 注意：package-lock.json 必须入库（CI 用 npm ci），此处只忽略其他包管理器的锁文件
yarn.lock
pnpm-lock.yaml

# Next.js / Vercel CLI
# .vercel/ 由 `vercel pull` 生成（project.json 与 .env.*.local），非源码也不入库；
# Vercel CLI 上传时本就忽略该目录，这里补 gitignore 避免触发根目录洁净度门禁。
.vercel/
dist/
dist-ssr/
*.local
.next/
*.tsbuildinfo

# Node.js
node_modules/

# pnpm store (local)
.pnpm-store/

# Global cache directory (should be in user home)
.dns-shield/

# Python cache (if any)
__pycache__/
/test_screenshots
/.workbuddy
*.bak
/.codebuddy
.gitmsg.txt
# 审查/提交消息等派生文档不入库；长期证据应写入 docs/，临时稿放 .tmp/。
review_*.md
CODE_REVIEW_*.md
# 注意：临时产物（_*.mjs / _*.txt / *.err / *.log / *.tsbuildinfo / preview.* 等）
# 的忽略规则已收敛至上方 .tmp/ 目录级规则。根目录散落由 check-root-clean.mjs 拦截，
# 「被忽略」不代表「被允许」，请勿在此重新添加散落文件的兜底忽略。

# 本地 nvm 版本文件：由开发环境按当前 Node 自动生成，每次可能不同；
# 项目的 Node 版本约束以 package.json engines 与 CI setup 输入为准，此文件不入库。
# check-root-clean.mjs 对 gitignored 条目直接放行，无需登记白名单。
.nvmdrc

# playwright-cli 等浏览器调试工具会在仓库根生成会话日志；属临时产物，
# 不入库且不得触发 check-root-clean.mjs 的散落条目拦截（v3.19.3）
.playwright-cli/
