# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
.cache
# 临时文件统一存放于根目录 .tmp/ 子目录（一次性脚本、探针、运行日志、中间产物）。
# 根目录及其他顶层位置禁止散落临时文件，由 CI 门禁 scripts/check-root-clean.mjs 拦截。
*.tmp
.tmp/
.tmp/**
tmp/
cache/
*err.txt
*out.txt
_build.txt
_lint.txt
_test.txt
_tsc.txt

# Package manager
# 注意：pnpm-lock.yaml 必须入库（CI 用 --frozen-lockfile），此处只忽略 npm/yarn 锁文件
package-lock.json
yarn.lock

# Next.js
.next/cache/
dist/
dist-ssr/
*.local
.next/trace
/.next
.next/
*.tsbuildinfo

# Node.js
node_modules/

# pnpm store (local)
.pnpm-store/

# Global cache directory (should be in user home)
.dns-shield/

# Python cache (if any)
__pycache__/
/test_screenshots
/.workbuddy
*.bak
/.codebuddy
.gitmsg.txt
review_*.md
CODE_REVIEW_*.md
*.err
_*.txt
# 临时脚本（_ 前缀）只允许存在于根 .tmp/ 子目录；散落在根目录或 scripts/ 会被
# scripts/check-root-clean.mjs 拦截并要求归位。下方忽略规则仅兜底防止误入库。
_*.mjs

# 本地 nvm 版本文件：由开发环境按当前 Node 自动生成，每次可能不同；
# 项目的 Node 版本约束以 package.json engines 与 CI setup 输入为准，此文件不入库。
# check-root-clean.mjs 对 gitignored 条目直接放行，无需登记白名单。
.nvmdrc
